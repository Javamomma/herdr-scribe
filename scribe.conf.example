# scribe.conf.example — copy to scribe.conf and edit for your machine.
#
#   cp scribe.conf.example scribe.conf
#
# scribe.sh auto-sources scribe.conf (next to itself) on every invocation, so
# `scribe.sh start|stop|status|abort|--doctor` picks this up automatically.
# scribe-analyst.sh, scribe-notes, and scribe-transcribe.py do NOT source this
# file themselves — they only see these variables if they've been exported
# into the environment already. The simplest way to make that true everywhere
# (including herdr panes, which spawn scribe-analyst.sh directly) is to also
# source this file from your shell profile (~/.bashrc / ~/.zshrc), e.g.:
#
#   [ -f /path/to/herdr-scribe/scribe.conf ] && source /path/to/herdr-scribe/scribe.conf
#
# Every variable below is optional; the default shown is what scribe uses if
# you leave it unset/commented out. Nothing here may name a real user,
# machine, or organization — keep overrides in your own untracked scribe.conf.

# --- Storage locations -------------------------------------------------

# RAM filesystem root under which the live (in-memory-backed) meeting
# directory is created and destroyed. Must be a tmpfs/RAM-backed mount for
# the no-recording guarantee to hold.
# export SCRIBE_RAMROOT="/dev/shm"

# Directory the finished transcript (<meeting-id>.md) is copied into on
# `stop`. Created if missing.
# export SCRIBE_OUTPUT_DIR="$PWD/meetings"

# Path to this config file itself. Only useful if you keep scribe.conf
# somewhere other than next to scribe.sh; scribe.sh sources
# ${SCRIBE_CONF:-<script-dir>/scribe.conf} on every run.
# export SCRIBE_CONF="/path/to/scribe.conf"

# --- Speech-to-text -----------------------------------------------------

# STT backend used by scribe-transcribe.py. "faster-whisper" streams real
# audio through the faster-whisper model; "fake" treats each stdin line as
# one already-recognized utterance (used by the test suite; needs no model,
# mic, or network).
# export SCRIBE_STT_BACKEND="faster-whisper"

# Path to a hotword glossary file (one term per line, "#" comments allowed —
# see glossary.txt.example) passed to the recognizer to bias it toward
# expected names/terms (e.g. attendee names, project jargon).
# export SCRIBE_GLOSSARY="/path/to/glossary.txt"

# Emit extra diagnostics to stderr from scribe-transcribe.py (e.g. glossary
# hotword count). Any non-empty value other than unset disables this; set to
# "1" to enable.
# export SCRIBE_DEBUG=""

# --- Capture pipeline -----------------------------------------------------

# PulseAudio recording source read for the mic ("[me]") stream. The default
# "@DEFAULT_SOURCE@" alias resolves to whatever the host's default recording
# source is (on WSL2, the WSLg PulseAudio bridge) — no device name is
# hardcoded here.
# export SCRIBE_CAPTURE_SOURCE="@DEFAULT_SOURCE@"

# Advanced/test override: a full shell command string to run in place of the
# normal composed mic(+optional loopback)->transcriber pipeline. Leave unset
# for normal use; the test suite sets this to "true" so no mic is required.
# export SCRIBE_CAPTURE_CMD=""

# --- Remote-participant loopback (optional, Windows-host bridge) ---------

# Set by `start --teams` (you shouldn't normally set this directly); when
# "1", scribe also composes a second "[them]" stream from SCRIBE_LOOPBACK_EXE.
# export SCRIBE_TEAMS="0"

# Path to the built Windows remote-participant loopback exe (see
# scribe-loopback-setup.sh). Unset/missing means mic-only — --teams then
# degrades gracefully with a warning instead of failing.
# export SCRIBE_LOOPBACK_EXE=""

# Path to csc.exe (the in-box .NET Framework C# compiler), used only by
# scribe-loopback-setup.sh to build the loopback bridge. Auto-detected on
# PATH / a short list of well-known Windows locations if unset.
# export SCRIBE_CSC_EXE=""

# Path to NAudio.dll, used only by scribe-loopback-setup.sh to build the
# loopback bridge. Auto-detected next to scribe-loopback-setup.sh if unset.
# export SCRIBE_NAUDIO_DLL=""

# The loopback exe emits the Windows render device's raw mix format, not the
# s16le/16k/mono the transcriber needs -- scribe.sh resamples it with
# `ffmpeg` before it reaches scribe-transcribe.py. These three describe that
# raw format for ffmpeg's benefit; the defaults (32-bit float, 48kHz, stereo)
# match the common Windows mix format, but a given device may differ -- check
# with a live smoke test and override if the [them] transcript comes out
# garbled. Path to the ffmpeg binary/executable itself is also overridable;
# unset/PATH-resolved "ffmpeg" is the default. If ffmpeg isn't found, --teams
# degrades gracefully to mic-only for the [them] stream (with a warning)
# rather than ever feeding raw device-format audio to the transcriber.
# export SCRIBE_LOOPBACK_FORMAT="f32le"
# export SCRIBE_LOOPBACK_RATE="48000"
# export SCRIBE_LOOPBACK_CHANNELS="2"
# export SCRIBE_FFMPEG_BIN="ffmpeg"

# --- Analyst + on-stop note -----------------------------------------------

# Headless LLM CLI invoked (with the prompt on stdin) by both the live
# analyst loop and the on-stop note generator. Must work non-interactively.
# To pin a specific model/backend, bake it into the command itself, e.g.:
#   export SCRIBE_LLM_CMD="claude -p --model <id>"
# There is no separate per-meeting `start --model` flag: the analyst pane
# and on-stop hook run as processes separate from `start`, so this env var
# is the only place a model selection can be threaded through.
# export SCRIBE_LLM_CMD="claude -p"

# Seconds between analyst rolling-brief refreshes (read by the analyst pane
# command in herdr-plugin.toml). There is no per-meeting `start
# --analyst-interval` flag -- the analyst pane is spawned by herdr as its
# own process, not a child of `start`, so this env var is the only way to
# set the cadence.
# export SCRIBE_ANALYST_INTERVAL="60"

# Command that prints OCR'd on-screen text to stdout, giving the analyst
# optional screen context (see scribe-screen-setup.sh). Unset means the
# analyst runs on transcript-only context.
# export SCRIBE_SCREEN_OCR_CMD=""

# Command run on `stop` against the written-out transcript path:
# `${SCRIBE_ON_STOP:-scribe-notes} <transcript-path>`. The default generates
# a generic meeting note (attendees / decisions / action items). Point this
# at your own downstream pipeline to extend what happens after a meeting
# without touching the capture engine.
# export SCRIBE_ON_STOP=""

# --- Scope + per-meeting glossary (§3) -----------------------------------
#
# NOTE ON PRECEDENCE for everything below: scribe.sh sources this file on
# every run, so a plain `export VAR="value"` line would OVERRIDE a value you
# exported in your shell for one invocation. If you want per-invocation env
# to win over this file, write entries in the guard form shown, e.g.:
#   export SCRIBE_ARTIFACT_CAP="${SCRIBE_ARTIFACT_CAP:-6}"

# Root directory containing one subdirectory per scope (the neutral key you
# pass to `start --scope <name>`). When set and <root>/<scope>/glossary.txt
# exists, its terms (plus the meeting's attendees/topic) are fed to the
# recognizer for that meeting only — additive; the global SCRIBE_GLOSSARY
# file is never modified. Unset: only attendees/topic are used.
# export SCRIBE_SCOPE_ROOT=""

# Set to "0" to disable per-meeting hotword injection entirely (the global
# glossary alone is used, exactly the pre-scope behavior).
# export SCRIBE_MEETING_GLOSSARY="1"

# --- Deep analyst / document retrieval (§1b, §2) -------------------------

# Root of the document corpus the deep tier may search READ-ONLY. Unset
# (default): the deep tier is OFF and the analyst behaves exactly as before.
# export SCRIBE_DEEP_CORPUS_ROOT=""

# Explicitly disable the deep tier even when a corpus root is set.
# export SCRIBE_DEEP_ENABLE="1"

# Model command for the deep tier only; falls back to SCRIBE_LLM_CMD.
# export SCRIBE_LLM_CMD_DEEP=""

# Hard timeout (seconds) on one retrieval; a hung retrieval appends a loud
# failure block and never wedges the analyst loop. Malformed → 120 + warning.
# export SCRIBE_DEEP_TIMEOUT="120"

# How many retrieval blocks the analyst pane shows (the bound is stated in
# the pane output) and how many corpus files one retrieval may read.
# Malformed → default + warning.
# export SCRIBE_DEEP_MAX_BLOCKS="3"
# export SCRIBE_DEEP_MAX_FILES="5"

# Document→text helper used on corpus files (see scribe-doc2text). Per-
# format extractors are overridable via SCRIBE_EXTRACT_CMD_<EXT> (uppercased
# extension; the command gets the file as "$1" and prints plain text), e.g.:
#   export SCRIBE_EXTRACT_CMD_PDF='pdftotext -layout -q "$1" -'
# export SCRIBE_DOC2TEXT_CMD=""

# --- Stop sequence: note + gate (§5) -------------------------------------

# Replace the core note generator run on stop (default: scribe-notes,
# invoked with the written transcript path). Legacy note: if you set
# SCRIBE_ON_STOP and no SCRIBE_NOTES_CMD, core writes no note of its own —
# your hook owns everything downstream, exactly the pre-gate behavior.
# export SCRIBE_NOTES_CMD=""

# Optional post-note gate: run with the note path ($1) and the still-live
# meeting dir ($2) after the note is written and BEFORE the in-memory
# transcript is destroyed. Exit 0 = proceed (destroy); exit 75 = HOLD (move
# the meeting dir to the quarantine dir instead of destroying it); any other
# failure or a timeout is treated as hold — fail closed in both directions.
# Core ships this seam and no policy.
# export SCRIBE_GATE_CMD=""

# Hard timeout (seconds) on the gate. Malformed → 60 + warning.
# export SCRIBE_GATE_TIMEOUT="60"

# Where held meetings are moved. Must be durable: a path inside the RAM
# root is refused (with a warning) and the default is used instead.
# export SCRIBE_QUARANTINE_DIR=""   # default: <output-dir>/quarantine

# Append-only audit log: one line per stop (timestamp, meeting, verdict,
# action, gate message verbatim) — written on every outcome, gate or not.
# export SCRIBE_AUDIT_LOG=""        # default: <output-dir>/scribe-audit.log

# --- Auto-artifacts (§4) -------------------------------------------------

# Master switch. "1" = on stop (after a clear gate verdict), classify the
# meeting NOTE for implied follow-up documents, auto-draft the strong
# candidates within the cap, and queue the rest for approval via
# `scribe.sh artifacts`. Default off: stop behaves exactly as before.
# export SCRIBE_ARTIFACTS="0"

# Max drafts built automatically per meeting. "0" = queue everything, build
# nothing. Malformed values fall back to 6 WITH a warning — note the unsafe
# direction is silently raising the cap (more unattended model builds than
# you asked for), so fix warnings rather than ignoring them.
# export SCRIBE_ARTIFACT_CAP="${SCRIBE_ARTIFACT_CAP:-6}"

# Allowlist of artifact types (comma/space separated, e.g. "summary memo
# status-update"). Unset/empty = every proposed type is enabled; with a
# list, anything else is recorded as disabled-type (visible, not built).
# export SCRIBE_ARTIFACT_TYPES=""

# Where candidate sidecars / the run log / review tasks / drafts live.
# export SCRIBE_ARTIFACTS_DIR=""      # default: <output-dir>/.artifacts
# export SCRIBE_RUN_LOG=""            # default: <artifacts-dir>/run.log
# export SCRIBE_REVIEW_TASKS=""       # default: <artifacts-dir>/review-tasks.tsv
# export SCRIBE_ARTIFACT_OUT_DIR=""   # default: <output-dir>/artifacts

# Replace the built-in draft generator: the command receives
# type/scope/audience/topic/note-path as $1..$5 and prints the document to
# stdout. Default: a generic SCRIBE_LLM_CMD draft. Drafts are never
# transmitted anywhere by scribe regardless of generator.
# export SCRIBE_ARTIFACT_GENERATOR_CMD=""

# Hard timeout (seconds) for one classification/generation model call.
# export SCRIBE_CLASSIFY_TIMEOUT="300"

# "0" disables the post-stop interactive review pane (tmux only; the
# `scribe.sh artifacts` CLI hint is printed either way).
# export SCRIBE_REVIEW_PANE="1"

# Bound on `scribe.sh artifacts --all` (the bound is stated in the output).
# export SCRIBE_ARTIFACTS_ALL_LIMIT="20"
